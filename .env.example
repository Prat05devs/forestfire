# Server-only variables. Never prefix either with VITE_.
# Optional: without these, the beta popup opens a prepared email for the visitor to send.
RESEND_API_KEY=
# An address on a domain you have verified with Resend.
BETA_FROM_EMAIL=
# Optional exact extra origin, e.g. for a custom preview. Production and VERCEL_URL are allowed automatically.
BETA_SITE_ORIGIN=
